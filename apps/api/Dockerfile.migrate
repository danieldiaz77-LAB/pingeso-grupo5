FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc AS build
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go install -trimpath -ldflags="-s -w" github.com/pressly/goose/v3/cmd/goose@v3.24.1 && \
    find /go/bin -type f -name goose -exec cp {} /out/goose \;
FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
WORKDIR /app
COPY --from=build --chown=65532:65532 /out/goose /usr/local/bin/goose
COPY --chown=65532:65532 apps/api/db/migrations/ /app/db/migrations/
USER 65532:65532
# Proceso de una sola ejecución; Compose espera su salida exitosa.
ENTRYPOINT ["goose", "-dir", "/app/db/migrations"]
