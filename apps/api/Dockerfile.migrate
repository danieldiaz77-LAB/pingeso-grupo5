FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.23@sha256:f70850ef6ce341e8b6427f677049145d63c0b7ce002d4d7e3d464828b1b96dcd AS build
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go install -trimpath -ldflags="-s -w" -tags=no_clickhouse,no_libsql,no_mssql,no_mysql,no_sqlite3,no_vertica,no_ydb,no_azuresql github.com/pressly/goose/v3/cmd/goose@v3.30.1 && \
    find /go/bin -type f -name goose -exec cp {} /out/goose \;
FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
WORKDIR /app
COPY --from=build --chown=65532:65532 /out/goose /usr/local/bin/goose
COPY --chown=65532:65532 apps/api/db/migrations/ /app/db/migrations/
USER 65532:65532
# Proceso de una sola ejecución; Compose espera su salida exitosa.
ENTRYPOINT ["goose", "-dir", "/app/db/migrations"]
