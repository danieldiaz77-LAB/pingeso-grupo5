# Completar con el nombre y N del servicio; grupo 5 no implica N=5.
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=replace-with-db-name
DATABASE_URL=replace-with-postgres-url-using-host-postgres
API_PORT=8080
API_ENV=dev
FRONTEND_URL=replace-with-http-localhost-port-51N0
# URL http/https del JWKS del servicio de identidad: obligatoria en prod
# (la API no arranca sin ella) y opcional en dev/test (vacía = sin auth).
AUTH_JWKS_URL=
TZ=America/Santiago
WEB_PORT=replace-with-51N0
BACKEND_PORT=replace-with-51N1
# Habilitar solo en desarrollo cuando corresponda.
# COMPOSE_PROFILES=dev
